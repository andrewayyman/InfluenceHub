# Ignore all top-level files and directories by default
/*

# Whitelist specific directories
!/Docs/
!/InfluenceHubApi/
!/InfluenceHubWeb/
!/openspec/
!/.agents/
!/.gitignore
!/.github/
!/.cursor/
!/.opencode/
!/.windsurf/    
!/.impeccable/  

# Standard developer environment ignores
**/.vs/
**/.vscode/
**/.DS_Store
**/*.user
**/.idea/

# Backend ignores
**/bin/
**/obj/
**/appsettings.Development.json
**/appsettings.*.json
!**/appsettings.json
**/*.http
**/uploads/
**/logs/

# Frontend ignores
**/node_modules/
**/dist/
**/build/
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log
